<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title %></title>
  <link rel="stylesheet" href="/public/css/site.css">
</head>
<body>
  <main class="page">
    <h1><%= it.title %></h1>
    <p><%= it.message %></p>
<% if (it.requestId) { %>
    <p class="muted">Reference: <code><%= it.requestId %></code></p>
<% } %>
  </main>
</body>
</html>
