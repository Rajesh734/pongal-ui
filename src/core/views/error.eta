<% const t = it.t ?? ((key) => key); %>
<!doctype html>
<html lang="<%= it.locale ?? 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t(it.title) %></title>
  <link rel="stylesheet" href="/public/css/site.css">
</head>
<body>
  <main class="page">
    <h1><%= t(it.title) %></h1>
    <p><%= t(it.message) %></p>
<% if (it.requestId) { %>
    <p class="muted"><%= t('Reference') %>: <code><%= it.requestId %></code></p>
<% } %>
  </main>
</body>
</html>
