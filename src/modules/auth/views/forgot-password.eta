<% layout('../../survey/views/layout', { title: it.title }) %>
    <section class="card auth-card">
      <h1><%= it.title %></h1>
<% if (it.message) { %>
      <p class="notice" role="status"><%= it.message %></p>
<% } %>
      <p><%= it.t('Enter your email and we will send a password reset link if a manual account exists.') %></p>
      <form method="post" action="/api/auth/forgot-password">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <fieldset class="field">
          <label for="email"><%= it.t('Email') %></label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="254">
        </fieldset>
        <button class="button primary" type="submit"><%= it.t('Send reset link') %></button>
      </form>
      <p><a href="/login"><%= it.t('Back to sign in') %></a></p>
    </section>
