<% layout('../../survey/views/layout', { title: it.title }) %>
    <section class="card auth-card">
      <h1><%= it.title %></h1>
<% if (it.message) { %>
      <p class="notice" role="alert"><%= it.message %></p>
<% } %>
      <form method="post" action="/api/auth/reset-password">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <input type="hidden" name="token" value="<%= it.token %>">
        <fieldset class="field">
          <label for="password"><%= it.t('New password') %></label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required>
        </fieldset>
        <button class="button primary" type="submit"><%= it.t('Update password') %></button>
      </form>
    </section>
