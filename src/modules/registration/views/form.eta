<% layout('../../survey/views/layout', { title: it.title }) %>
<%
  const t = it.t;
  const reg = it.event.configSnapshot.registration;
  const limits = reg.performance_duration_minutes;
  const price = (cents) => cents ? `$${cents / 100}` : t('Free');
  const ageOptions = [['11_plus', '11+', it.prices.age_11_plus], ['5_to_10', '5-10', it.prices.age_5_to_10], ['under_5', '0-4', it.prices.under_5]];
%>
    <section class="card registration-card">
      <h1><%= it.title %></h1>
<% if (it.message) { %>
      <p class="notice" role="alert"><%= it.message %></p>
<% } %>
      <p><%= t('Register your household for {event}. Payment is completed separately by Zelle.', { event: it.event.name }) %></p>
      <form method="post" action="<%= it.formAction ?? '/register' %>" data-validate-on-blur novalidate>
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <section class="form-section" aria-labelledby="contact-heading">
          <h2 id="contact-heading" class="form-section__title"><span class="step" aria-hidden="true">1</span> <%= t('Contact details') %></h2>
          <fieldset class="field">
            <label for="contactEmail"><%= t('Email') %></label>
            <input id="contactEmail" name="contactEmail" type="email" autocomplete="email" required maxlength="254" value="<%= it.values.contactEmail ?? '' %>">
            <% if (it.errors.contactEmail) { %><p class="field-error" role="alert"><%= it.errors.contactEmail %></p><% } %>
          </fieldset>
          <fieldset class="field">
            <span class="form-label" aria-hidden="true"><%= t('Mobile number') %></span>
            <div class="phone-row">
              <div class="form-control">
                <label for="mobileCountryCode" class="visually-hidden"><%= t('Mobile country code') %></label>
                <select id="mobileCountryCode" name="mobileCountryCode" data-short-label>
                  <% it.phoneCountries.forEach((country) => { %>
                  <option value="<%= country.code %>" <%= (it.values.mobileCountryCode ?? '+1') === country.code ? 'selected' : '' %>><%= country.label %></option>
                  <% }) %>
                </select>
                <label for="mobileOtherCountryCode" data-other-code-label hidden class="visually-hidden"><%= t('Other calling code') %></label>
                <input id="mobileOtherCountryCode" name="mobileOtherCountryCode" type="tel" placeholder="+34" value="<%= it.values.mobileOtherCountryCode ?? '' %>" hidden>
              </div>
              <div class="form-control">
                <label for="mobileNumber" class="visually-hidden"><%= t('Mobile number') %></label>
                <input id="mobileNumber" name="mobileNumber" type="tel" autocomplete="tel-national" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" required placeholder="6031234567" value="<%= it.values.mobileNumber ?? '' %>">
              </div>
            </div>
            <% if (it.errors.mobileE164) { %><p class="field-error" role="alert"><%= it.errors.mobileE164 %></p><% } %>
          </fieldset>
          <fieldset class="field whatsapp-group">
            <legend><%= t('WhatsApp (optional)') %></legend>
            <label class="choice"><input id="whatsappSameAsMobile" type="checkbox" name="whatsappSameAsMobile" value="yes" <%= it.values.whatsappSameAsMobile ? 'checked' : '' %>> <span><%= t('My WhatsApp number is the same as my mobile number') %></span></label>
            <div data-whatsapp-fields <%= it.values.whatsappSameAsMobile ? 'hidden' : '' %>>
            <span class="form-label" aria-hidden="true"><%= t('WhatsApp number') %></span>
            <div class="phone-row">
              <div class="form-control">
                <label for="whatsappCountryCode" class="visually-hidden"><%= t('WhatsApp country code') %></label>
                <select id="whatsappCountryCode" name="whatsappCountryCode" data-short-label>
                  <% it.phoneCountries.forEach((country) => { %>
                  <option value="<%= country.code %>" <%= (it.values.whatsappCountryCode ?? '+1') === country.code ? 'selected' : '' %>><%= country.label %></option>
                  <% }) %>
                </select>
                <label for="whatsappOtherCountryCode" data-other-code-label hidden class="visually-hidden"><%= t('Other WhatsApp calling code') %></label>
                <input id="whatsappOtherCountryCode" name="whatsappOtherCountryCode" type="tel" placeholder="+34" value="<%= it.values.whatsappOtherCountryCode ?? '' %>" hidden>
              </div>
              <div class="form-control">
                <label for="whatsappNumber" class="visually-hidden"><%= t('WhatsApp number') %></label>
                <input id="whatsappNumber" name="whatsappNumber" type="tel" autocomplete="tel-national" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="9876543210" value="<%= it.values.whatsappSameAsMobile ? '' : it.values.whatsappNumber ?? '' %>">
              </div>
            </div>
            </div>
            <% if (it.errors.whatsappE164) { %><p class="field-error" role="alert"><%= it.errors.whatsappE164 %></p><% } %>
            <label class="choice consent"><input id="whatsappConsent" type="checkbox" name="whatsappConsent" value="yes" <%= it.values.whatsappConsent ? 'checked' : '' %>> <span><%= t('Organizers may contact me on WhatsApp about this event.') %></span></label>
            <% if (it.errors.whatsappConsent) { %><p class="field-error" role="alert"><%= it.errors.whatsappConsent %></p><% } %>
          </fieldset>
        </section>
        <section class="form-section" aria-labelledby="attendees-heading">
          <h2 id="attendees-heading" class="form-section__title"><span class="step" aria-hidden="true">2</span> <%= t('Attendees') %></h2>
          <p class="form-section__intro"><%= t('The first attendee is the primary contact. Add everyone in your household who is coming.') %></p>
        <% if (it.errors.attendees) { %><p class="field-error" role="alert"><%= it.errors.attendees %></p><% } %>
        <div id="attendee-list" aria-live="polite">
<% (it.values.attendees ?? [{ name: '', ageBand: '11_plus', willingToVolunteer: false, volunteerRoles: [] }]).forEach((attendee, index) => { %>
          <fieldset class="field attendee-row form-card">
            <legend><%= index === 0 ? t('Primary contact and attendee 1') : t('Attendee {n}', { n: index + 1 }) %></legend>
            <button class="link-button remove-attendee" type="button" data-remove-attendee <%= index === 0 ? 'disabled hidden' : '' %>><%= t('Remove') %></button>
            <div class="form-grid">
              <div class="form-control">
                <label for="attendeeName<%= index %>"><%= index === 0 ? t('Full name') : t('Name') %></label>
                <input id="attendeeName<%= index %>" name="attendeeName" autocomplete="<%= index === 0 ? 'name' : 'off' %>" required minlength="<%= index === 0 ? 2 : 1 %>" maxlength="150" value="<%= attendee.name ?? '' %>">
                <% if (index === 0 && it.errors.contactName) { %><p class="field-error" role="alert"><%= it.errors.contactName %></p><% } %>
              </div>
              <div class="form-control">
            <% if (index === 0) { %>
                <span class="form-label"><%= t('Age group') %></span>
                <input type="hidden" name="attendeeAgeBand" value="11_plus">
                <p class="primary-age-band"><%= t('11+ (adult primary contact) - {price}', { price: price(it.prices.age_11_plus) }) %></p>
            <% } else { %>
                <label for="attendeeAgeBand<%= index %>"><%= t('Age group on event date') %></label>
                <select id="attendeeAgeBand<%= index %>" name="attendeeAgeBand" class="input-compact" required>
                  <% ageOptions.forEach(([value, label, cents]) => { %>
                  <option value="<%= value %>" <%= attendee.ageBand === value ? 'selected' : '' %>><%= label %> - <%= price(cents) %></option>
                  <% }) %>
                </select>
            <% } %>
              </div>
            </div>
            <div class="attendee-volunteer">
              <label class="choice"><input type="checkbox" name="attendeeWilling_<%= index %>" value="yes" <%= attendee.willingToVolunteer ? 'checked' : '' %>> <span><%= t('Willing to volunteer') %></span></label>
              <fieldset class="volunteer-roles">
                <legend class="form-label"><%= t('Which roles can they help with?') %></legend>
                <div class="role-grid">
                <% it.roles.forEach((role) => { %>
                  <label class="choice"><input type="checkbox" name="attendeeRoles_<%= index %>" value="<%= role.code %>" <%= (attendee.volunteerRoles ?? []).includes(role.code) ? 'checked' : '' %>> <span><%= t(role.label) %></span></label>
                <% }) %>
                </div>
              </fieldset>
            </div>
          </fieldset>
<% }) %>
        </div>
        <template id="attendee-template">
          <fieldset class="field attendee-row form-card">
            <legend><%= t('Attendee {n}', { n: '__INDEX_DISPLAY__' }) %></legend>
            <button class="link-button remove-attendee" type="button" data-remove-attendee><%= t('Remove') %></button>
            <div class="form-grid">
              <div class="form-control">
                <label for="attendeeName__INDEX__"><%= t('Name') %></label>
                <input id="attendeeName__INDEX__" name="attendeeName" required minlength="1" maxlength="150">
              </div>
              <div class="form-control">
                <label for="attendeeAgeBand__INDEX__"><%= t('Age group on event date') %></label>
                <select id="attendeeAgeBand__INDEX__" name="attendeeAgeBand" class="input-compact" required>
                  <% ageOptions.forEach(([value, label, cents]) => { %>
                  <option value="<%= value %>" <%= value === '11_plus' ? 'selected' : '' %>><%= label %> - <%= price(cents) %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="attendee-volunteer">
              <label class="choice"><input type="checkbox" name="attendeeWilling___INDEX__" value="yes"> <span><%= t('Willing to volunteer') %></span></label>
              <fieldset class="volunteer-roles">
                <legend class="form-label"><%= t('Which roles can they help with?') %></legend>
                <div class="role-grid">
                <% it.roles.forEach((role) => { %>
                  <label class="choice"><input type="checkbox" name="attendeeRoles___INDEX__" value="<%= role.code %>"> <span><%= t(role.label) %></span></label>
                <% }) %>
                </div>
              </fieldset>
            </div>
          </fieldset>
        </template>
        <button class="button button--add" type="button" id="add-attendee"><span aria-hidden="true">+</span> <%= t('Add attendee') %></button>
        </section>
        <section class="form-section" aria-labelledby="performances-heading">
          <h2 id="performances-heading" class="form-section__title"><span class="step" aria-hidden="true">3</span> <span><%= t('Cultural performances') %> <span class="optional">(<%= t('optional') %>)</span></span></h2>
          <p class="form-section__intro"><%~ t('Your household can register up to {max} performances. For more, {link}.', { max: reg.max_performances, link: '<a href="/about">' + it.esc(t('contact the organizers')) + '</a>' }) %></p>
          <ul class="rule-list" aria-label="<%= t('Maximum performance time') %>">
            <li><strong><%= t('Solo:') %></strong> <%= t('up to {n} min', { n: limits.solo }) %></li>
            <li><strong><%= t('2-4 performers:') %></strong> <%= t('up to {n} min', { n: limits.group_2_to_4 }) %></li>
            <li><strong><%= t('5 or more:') %></strong> <%= t('up to {n} min', { n: limits.group_5_plus }) %></li>
          </ul>
      <% if (it.errors.performances) { %>
          <p class="error" role="alert"><%= it.errors.performances %></p>
      <% } %>
          <div id="performance-list" data-max-performances="<%= reg.max_performances %>" data-limit-solo="<%= limits.solo %>" data-limit-small="<%= limits.group_2_to_4 %>" data-limit-large="<%= limits.group_5_plus %>">
      <% (it.values.performances ?? []).forEach((performance, index) => { %>
            <fieldset class="field performance-row form-card">
              <legend><%= t('Performance {n}', { n: index + 1 }) %></legend>
              <button class="link-button remove-performance" type="button" data-remove-performance><%= t('Remove') %></button>
              <div class="form-grid">
                <div class="form-control">
                  <label for="performanceTitle<%= index %>"><%= t('Performance name or type') %></label>
                  <input id="performanceTitle<%= index %>" name="performanceTitle" maxlength="150" placeholder="<%= t('e.g. Bharatanatyam, song, skit') %>" value="<%= performance.title ?? '' %>">
                </div>
                <div class="form-control">
                  <label for="performanceParticipants<%= index %>"><%= t('Performer or group name') %></label>
                  <input id="performanceParticipants<%= index %>" name="performanceParticipants" maxlength="150" placeholder="<%= t('e.g. Priya and friends') %>" value="<%= performance.participantNames ?? '' %>">
                </div>
              </div>
              <div class="form-grid form-grid--pair">
                <div class="form-control">
                  <label for="performanceParticipantCount<%= index %>"><%= t('Performers') %></label>
                  <input id="performanceParticipantCount<%= index %>" name="performanceParticipantCount" class="input-tiny" type="number" min="1" max="100" step="1" inputmode="numeric" value="<%= performance.participantCount ?? '' %>">
                </div>
                <div class="form-control">
                  <label for="performanceDuration<%= index %>"><%= t('Minutes') %></label>
                  <input id="performanceDuration<%= index %>" name="performanceDuration" class="input-tiny" type="number" min="1" max="<%= limits.group_5_plus %>" step="1" inputmode="numeric" value="<%= performance.durationMinutes ?? '' %>">
                  <p class="hint" data-duration-hint></p>
                </div>
              </div>
              <div class="form-control">
                <label for="performanceIntroduction<%= index %>"><%= t('Short introduction for the compere') %></label>
                <textarea id="performanceIntroduction<%= index %>" name="performanceIntroduction" maxlength="500" rows="3" placeholder="<%= t('One or two sentences the host will read before you perform.') %>"><%= performance.compereIntroduction ?? '' %></textarea>
              </div>
            </fieldset>
      <% }) %>
          </div>
          <template id="performance-template">
            <fieldset class="field performance-row form-card">
              <legend><%= t('Performance {n}', { n: '__INDEX_DISPLAY__' }) %></legend>
              <button class="link-button remove-performance" type="button" data-remove-performance><%= t('Remove') %></button>
              <div class="form-grid">
                <div class="form-control">
                  <label for="performanceTitle__INDEX__"><%= t('Performance name or type') %></label>
                  <input id="performanceTitle__INDEX__" name="performanceTitle" maxlength="150" placeholder="<%= t('e.g. Bharatanatyam, song, skit') %>">
                </div>
                <div class="form-control">
                  <label for="performanceParticipants__INDEX__"><%= t('Performer or group name') %></label>
                  <input id="performanceParticipants__INDEX__" name="performanceParticipants" maxlength="150" placeholder="<%= t('e.g. Priya and friends') %>">
                </div>
              </div>
              <div class="form-grid form-grid--pair">
                <div class="form-control">
                  <label for="performanceParticipantCount__INDEX__"><%= t('Performers') %></label>
                  <input id="performanceParticipantCount__INDEX__" name="performanceParticipantCount" class="input-tiny" type="number" min="1" max="100" step="1" inputmode="numeric">
                </div>
                <div class="form-control">
                  <label for="performanceDuration__INDEX__"><%= t('Minutes') %></label>
                  <input id="performanceDuration__INDEX__" name="performanceDuration" class="input-tiny" type="number" min="1" max="<%= limits.group_5_plus %>" step="1" inputmode="numeric">
                  <p class="hint" data-duration-hint></p>
                </div>
              </div>
              <div class="form-control">
                <label for="performanceIntroduction__INDEX__"><%= t('Short introduction for the compere') %></label>
                <textarea id="performanceIntroduction__INDEX__" name="performanceIntroduction" maxlength="500" rows="3" placeholder="<%= t('One or two sentences the host will read before you perform.') %>"></textarea>
              </div>
            </fieldset>
          </template>
          <button class="button button--add" type="button" id="add-performance"><span aria-hidden="true">+</span> <%= t('Add performance') %></button>
        </section>
        <section class="form-section" aria-labelledby="total-heading">
        <div id="family-summary" class="family-summary" data-prices="<%= JSON.stringify(it.prices) %>" aria-live="polite">
          <h2 id="total-heading" class="form-section__title"><span class="step" aria-hidden="true">4</span> <%= t('Family total') %></h2>
          <p><span>11+: <output data-count="age_11_plus"><%= it.ageBandSummary.age_11_plus.count %></output> x <%= price(it.prices.age_11_plus) %></span> <output data-subtotal="age_11_plus">$<%= (it.ageBandSummary.age_11_plus.subtotalCents / 100).toFixed(2) %></output></p>
          <p><span>5-10: <output data-count="age_5_to_10"><%= it.ageBandSummary.age_5_to_10.count %></output> x <%= price(it.prices.age_5_to_10) %></span> <output data-subtotal="age_5_to_10">$<%= (it.ageBandSummary.age_5_to_10.subtotalCents / 100).toFixed(2) %></output></p>
          <p><span>0-4: <output data-count="under_5"><%= it.ageBandSummary.under_5.count %></output> x <%= price(it.prices.under_5) %></span> <output data-subtotal="under_5">$<%= (it.ageBandSummary.under_5.subtotalCents / 100).toFixed(2) %></output></p>
          <p class="family-summary__total"><strong><%= t('Total due') %></strong> <strong><output id="family-total">$<%= (it.initialTotalCents / 100).toFixed(2) %></output></strong></p>
        </div>
        <button class="button primary" type="submit"><%= t('Continue to payment instructions') %></button>
        </section>
      </form>
    </section>
    <script type="module" src="/public/js/registration.js"></script>