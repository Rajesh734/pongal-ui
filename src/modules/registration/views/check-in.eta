<% layout('../../survey/views/layout', { title: it.title }) %>
    <section class="card">
      <h1><%= it.title %></h1>
      <p><%= it.event.name %></p>
<% if (it.message) { %>
      <p class="notice" role="<%= it.messageIsError ? 'alert' : 'status' %>"><%= it.message %></p>
<% } %>
      <section class="check-in-scanner" aria-label="<%= it.t('QR scanner') %>">
        <video id="check-in-camera" autoplay muted playsinline hidden></video>
        <div class="check-in-scanner__actions">
          <button class="button primary" type="button" id="start-camera"><%= it.t('Scan QR code with camera') %></button>
          <button class="button" type="button" id="stop-camera" hidden><%= it.t('Stop camera') %></button>
        </div>
        <p id="camera-status" class="muted" aria-live="polite"><%= it.t('Tap the button and allow camera access, then point the camera at the household entry pass. You can also enter the pass code manually.') %></p>
      </section>
<%
  const result = it.result;
  const tone = !result ? null
    : result.status === 'ready' ? 'ready'
    : result.status === 'checked_in' ? 'success'
    : result.status === 'already_checked_in' ? 'warning'
    : 'error';
  const resultMessage = result && result.status !== 'ready' ? it.errorMessages[result.status] ?? it.errorMessages.invalid : null;
%>
<% if (result) { %>
      <section class="check-in-result check-in-result--<%= tone %>" role="<%= tone === 'error' ? 'alert' : 'status' %>">
<% if (tone === 'ready') { %>
        <h2><%= it.t('Review household') %></h2>
<% } else { %>
        <p class="check-in-result__message"><%= resultMessage %></p>
<% } %>
<% if (result.household) { %>
        <p class="check-in-result__household"><%= result.household.name %> - <%= result.attendees?.length === 1 ? it.t('{n} attendee', { n: 1 }) : it.t('{n} attendees', { n: result.attendees?.length ?? 0 }) %></p>
<% } %>
<% if (result.attendees?.length) { %>
        <ul>
<% result.attendees.forEach((attendee) => { %>
          <li><%= attendee.name %> (<%= it.ageGroupLabels[attendee.ageBand] ?? attendee.ageBand %>)</li>
<% }) %>
        </ul>
<% } %>
<% if (tone === 'ready') { %>
        <form method="post" action="/check-in/confirm">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
          <input type="hidden" name="token" value="<%= result.token ?? '' %>">
          <button class="button primary" type="submit"><%= it.t('Check in household') %></button>
        </form>
<% } %>
      </section>
<% } %>
      <form method="post" action="/check-in/search" data-validate-on-blur novalidate>
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <fieldset class="field">
          <label for="household-search"><%= it.t('Search paid households') %></label>
          <input id="household-search" name="query" value="<%= it.searchQuery %>" autocomplete="off" required>
          <p class="muted"><%= it.t('Search by household name, phone number, or email address.') %></p>
        </fieldset>
        <button class="button" type="submit"><%= it.t('Search households') %></button>
      </form>
      <form method="post" action="/check-in/preview" data-validate-on-blur novalidate>
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
        <fieldset class="field">
          <label for="manual-token"><%= it.t('Enter pass code manually') %></label>
          <input id="manual-token" name="token" autocomplete="off" required>
        </fieldset>
        <button class="button" type="submit"><%= it.t('Look up pass') %></button>
      </form>
<% if (it.searchQuery) { %>
      <section class="check-in-search-results" aria-live="polite">
        <h2><%= it.t('Search results') %></h2>
<% if (!it.searchResults.length) { %>
        <p class="muted"><%= it.t('No confirmed paid household matched that search.') %></p>
<% } %>
<% for (const candidate of it.searchResults) { %>
        <article class="check-in-candidate">
          <div>
            <h3><%= candidate.household.name %></h3>
            <p class="muted"><%= candidate.household.email %> - <%= candidate.household.mobileE164 %></p>
            <p><%= it.t('{n} attendees', { n: candidate.attendees.length }) %></p>
          </div>
<% if (candidate.alreadyCheckedIn) { %>
          <strong class="check-in-candidate__status"><%= it.t('Already checked in') %></strong>
<% } else { %>
          <form method="post" action="/check-in/confirm-registration">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
            <input type="hidden" name="registrationId" value="<%= candidate.registrationId %>">
            <input type="hidden" name="query" value="<%= it.searchQuery %>">
            <button class="button primary" type="submit"><%= it.t('Check in household') %></button>
          </form>
<% } %>
        </article>
<% } %>
      </section>
<% } %>
    </section>
    <script type="module" src="/public/js/check-in.js"></script>