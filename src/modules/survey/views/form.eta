<%
  layout('./layout', { title: it.title, enhance: true, importMap: it.importMap, turnstileSiteKey: it.turnstileSiteKey });
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => '&#' + c.charCodeAt(0) + ';');
  const first = (x) => (Array.isArray(x) ? x[0] : x);
  const v = (k) => esc(first(it.values[k]) ?? '');
  const has = (k, val) => { const x = it.values[k]; return Array.isArray(x) ? x.includes(val) : x === val; };
  const err = (k) => it.errors[k];
  const invalid = (k) => (err(k) ? ' aria-invalid="true"' : '');
  const errorP = (k) => '<p class="error" id="' + k + '-error" role="alert"' + (err(k) ? '' : ' hidden') + '>' + esc(err(k)) + '</p>';
  const heading = (s, id) => '<h2 class="card__title" id="' + id + '"><span lang="ta">' + esc(s.ta) + '</span> <span class="card__sep" aria-hidden="true">·</span> <span>' + esc(s.en) + '</span></h2>';
  const commentsLength = String(first(it.values.comments) ?? '').trim().length;
  const t = it.t;
  const likelihoods = [['definitely', t('Definitely')], ['likely', t('Likely')], ['maybe', t('Maybe')]];
  const S = it.m.sections;
%>
    <h1><%= t('{event} interest survey', { event: it.event.name }) %></h1>
    <p class="intro"><%= t('This is not a registration. It helps organizers decide on the event and plan the venue, food and contribution.') %></p>

    <div id="error-summary" class="error-summary" role="alert" tabindex="-1"<% if (it.summary) { %> autofocus<% } else { %> hidden<% } %>><%= it.summary ?? '' %></div>

    <script type="application/json" id="survey-config"><%~ it.configJson %></script>

    <form method="post" action="<%= it.action %>" novalidate x-data="surveyForm" @focusout="onBlur" @change="onChange" @input="onInput" @submit="onSubmit">
      <section class="card" aria-labelledby="section-about">
        <%~ heading(S.about, 'section-about') %>
        <div class="field">
          <label for="name"><%= t('Your name') %></label>
          <input id="name" name="name" type="text" autocomplete="name" maxlength="200" value="<%~ v('name') %>" aria-describedby="name-error"<%~ invalid('name') %>>
          <%~ errorP('name') %>
        </div>

        <div class="field">
          <label for="email"><%= t('Email') %></label>
<% if (it.mode === 'edit') { %>
          <p class="readonly" id="email"><%= it.email %></p>
          <p class="muted"><%= it.m.emailReadOnly %></p>
<% } else { %>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" value="<%~ v('email') %>" aria-describedby="email-error"<%~ invalid('email') %>>
          <%~ errorP('email') %>
<% } %>
        </div>

        <div class="field">
          <label for="mobile"><%= t('US mobile number') %> <span class="optional">(<%= t('optional') %>)</span></label>
          <input id="mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="20" value="<%~ v('mobile') %>" aria-describedby="mobile-error"<%~ invalid('mobile') %>>
          <%~ errorP('mobile') %>
        </div>
      </section>

      <section class="card" aria-labelledby="section-attending">
        <%~ heading(S.attending, 'section-attending') %>
        <fieldset class="field" aria-describedby="days-error">
          <legend><%= t('Which days could you attend?') %></legend>
          <div class="choices">
<% for (const day of it.days) { %>
            <label class="choice"><input type="checkbox" name="days" value="<%= day.date %>"<% if (has('days', day.date)) { %> checked<% } %>> <%= t(day.label) %></label>
<% } %>
          </div>
          <%~ errorP('days') %>
        </fieldset>

<% for (const day of it.days) { const key = it.likelihoodKey(day.date); %>
        <fieldset class="field likelihood" data-day="<%= day.date %>" aria-describedby="<%= key %>-error">
          <legend><%= it.m.likelihoodQuestion(day.label) %></legend>
          <div class="choices">
<% for (const [code, label] of likelihoods) { %>
            <label class="choice"><input type="radio" name="<%= key %>" value="<%= code %>"<% if (has(key, code)) { %> checked<% } %>> <%= label %></label>
<% } %>
          </div>
          <%~ errorP(key) %>
        </fieldset>
<% } %>

        <fieldset class="field" aria-describedby="headcount-error">
          <legend><%= t('How many people in your family would come?') %></legend>
          <div class="counts">
<% for (const band of it.survey.headcount_bands) { const key = it.headcountKey(band.code); %>
            <div class="count">
              <label for="<%= key %>"><%= t(band.label) %></label>
              <input id="<%= key %>" name="<%= key %>" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" maxlength="3" value="<%~ v(key) %>" aria-describedby="<%= key %>-error"<%~ invalid(key) %>>
              <%~ errorP(key) %>
            </div>
<% } %>
          </div>
          <%~ errorP('headcount') %>
        </fieldset>
      </section>

      <section class="card" aria-labelledby="section-food">
        <%~ heading(S.food, 'section-food') %>
        <fieldset class="field" aria-describedby="food-error">
          <legend><%= t('Food preference') %></legend>
          <div class="choices">
<% for (const o of it.survey.food_options) { %>
            <label class="choice"><input type="radio" name="food" value="<%= o.code %>"<% if (has('food', o.code)) { %> checked<% } %>> <%= t(o.label) %></label>
<% } %>
          </div>
          <%~ errorP('food') %>
        </fieldset>

        <fieldset class="field" aria-describedby="roles-error">
          <legend><%= t('Would you like to volunteer?') %> <span class="optional">(<%= t('optional, pick any') %>)</span></legend>
          <div class="choices">
<% for (const o of it.survey.volunteer_roles) { %>
            <label class="choice"><input type="checkbox" name="roles" value="<%= o.code %>"<% if (has('roles', o.code)) { %> checked<% } %>> <%= t(o.label) %></label>
<% } %>
          </div>
          <%~ errorP('roles') %>
        </fieldset>

        <fieldset class="field" aria-describedby="cultural-error">
          <legend><%= t('Interested in a cultural performance?') %></legend>
          <div class="choices">
<% for (const o of it.survey.cultural_options) { %>
            <label class="choice"><input type="radio" name="cultural" value="<%= o.code %>"<% if (has('cultural', o.code)) { %> checked<% } %>> <%= t(o.label) %></label>
<% } %>
          </div>
          <%~ errorP('cultural') %>
        </fieldset>

        <fieldset class="field" aria-describedby="contribution-error">
          <legend><%= t("Contribution per adult you'd be comfortable with") %></legend>
          <div class="choices">
<% for (const o of it.survey.contribution_options) { %>
            <label class="choice"><input type="radio" name="contribution" value="<%= o.code %>"<% if (has('contribution', o.code)) { %> checked<% } %>> <%= t(o.label) %></label>
<% } %>
          </div>
          <%~ errorP('contribution') %>
        </fieldset>
      </section>

      <section class="card" aria-labelledby="section-finish">
        <%~ heading(S.finish, 'section-finish') %>
        <div class="field">
          <label for="comments"><%= t('Comments') %> <span class="optional">(<%= t('optional') %>)</span></label>
          <textarea id="comments" name="comments" rows="4" aria-describedby="comments-counter comments-error"<%~ invalid('comments') %>><%~ v('comments') %></textarea>
          <p class="muted counter" id="comments-counter" aria-live="polite"><%= it.m.commentsCounter(commentsLength, it.survey.comments_max) %></p>
          <%~ errorP('comments') %>
        </div>

        <div class="field">
          <label class="choice consent"><input type="checkbox" name="consent" value="yes"<% if (has('consent', 'yes')) { %> checked<% } %> aria-describedby="consent-error"> <%= it.m.consentText(it.event.name) %></label>
          <%~ errorP('consent') %>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" value="">
        </div>

<% if (it.turnstileSiteKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= it.turnstileSiteKey %>"></div>
<% } %>

        <button type="submit" class="button primary"><%= it.mode === 'edit' ? t('Save changes') : t('Submit') %></button>
      </section>
    </form>
