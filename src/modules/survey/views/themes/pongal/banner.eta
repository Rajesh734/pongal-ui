  <section class="festive-banner" aria-label="<%= it.eventName %>">
      <div class="festive-banner__inner">
        <div class="festive-banner__copy">
          <p class="festive-banner__greeting" lang="ta"><%= it.m.pongalGreeting %></p>
          <p class="festive-banner__event"><%= it.eventName %></p>
        </div>
        <div class="festive-banner__scene" aria-hidden="true">
          <div class="scene-side scene-left">
            <%~ include('./art/sugarcane') %>
            <%~ include('./art/figures') %>
          </div>
          <div class="scene-center">
            <%~ include('./art/sun') %>
            <%~ include('./art/pot') %>
          </div>
          <div class="scene-side scene-right">
            <%~ include('./art/bull') %>
            <%~ include('./art/sugarcane') %>
          </div>
        </div>
    </div>
  </section>
