<%
  const t = it.t ?? ((key) => key);
  const navLinks = it.adminPath
    ? [['/admin', t('Dashboard')], ['/admin/registrations', t('Registrations')], ['/admin/payments', t('Payments')], ['/admin/volunteers', t('Volunteers')], ['/admin/check-in-access', t('Check-in Access')], ['/check-in', t('Scan Passes')], ['/', t('Public site')]]
    : [['/', t('Home')], ['/about', t('About')], ['/register', t('Register')]];
  const navLabel = it.adminPath ? t('Organizer navigation') : t('Main navigation');
  const mobileNavLabel = it.adminPath ? t('Organizer mobile navigation') : t('Main mobile navigation');
%>
  <header class="site-header">
    <div class="site-header__inner">
      <details class="mobile-menu">
        <summary aria-label="<%= t('Open navigation menu') %>">
          <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </summary>
        <nav class="mobile-menu__panel" aria-label="<%= mobileNavLabel %>">
<% navLinks.forEach(([href, label]) => { %>
          <a href="<%= href %>"<%~ it.adminPath === href ? ' aria-current="page"' : '' %>><%= label %></a>
<% }) %>
        </nav>
      </details>
      <div class="site-brand">
<% if (it.site.logo) { %>
    <img class="site-logo" src="<%= it.site.logo %>" alt="<%= it.site.name %> logo" width="26" height="56">
<% } %>
    <div class="site-header__identity">
        <p class="site-name"><%= it.site.name %></p>
        <p class="site-location"><%= it.site.location %></p>
      </div>
  <% if (it.site.logo) { %>
    <img class="site-logo site-logo--end" src="<%= it.site.logo %>" alt="" aria-hidden="true" width="26" height="56">
  <% } %>
      </div>
      <details class="account-menu">
        <summary aria-label="<%= t('Account menu') %>"><svg class="account-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="7.5" r="4.5"/><path d="M3 21c0-4.6 4-7.5 9-7.5s9 2.9 9 7.5z"/></svg></summary>
        <div class="account-menu__panel">
<% if (it.siteAccount) { %>
          <p class="account-menu__name"><%= it.siteAccount.name %></p>
          <a href="/account/profile"><%= t('Profile') %></a>
          <a href="/account/registrations"><%= t('My Registrations') %></a>
<% if (it.canCheckIn) { %>
          <a href="/check-in"><%= t('Scan Passes') %></a>
<% } %>
          <form method="post" action="/api/auth/logout">
            <input type="hidden" name="_csrf" value="<%= it.navCsrfToken ?? '' %>">
            <button type="submit"><%= t('Log out') %></button>
          </form>
<% } else { %>
          <a href="/login"><%= t('Sign in') %></a>
          <a href="/signup"><%= t('Sign up') %></a>
<% } %>
        </div>
      </details>
    </div>
    <nav class="site-nav site-nav--desktop" aria-label="<%= navLabel %>">
<% navLinks.forEach(([href, label]) => { %>
        <a href="<%= href %>"<%~ it.adminPath === href ? ' aria-current="page"' : '' %>><%= label %></a>
<% }) %>
      </nav>
  </header>
