<!doctype html>
<html lang="<%= it.locale ?? 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title %></title>
  <link rel="icon" type="image/svg+xml" href="/public/img/favicon.svg">
<% if (it.site.logo) { %>
  <link rel="apple-touch-icon" href="<%= it.site.logo %>">
<% } %>
  <link rel="stylesheet" href="/public/css/site.css">
<% if (it.importMap) { %>
  <script type="importmap"><%~ it.importMap %></script>
<% } %>
<% if (it.enhance) { %>
  <script type="module" src="/public/js/survey.js"></script>
<% } %>
<% if (it.turnstileSiteKey) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>
</head>
<body<% if (it.theme) { %> class="theme-<%= it.theme %>"<% } %>>
<%~ include('./partials/site-header', { site: it.site }) %>
<% if (!it.adminPath && it.locales) { %>
  <nav class="lang-bar" aria-label="<%= it.t('Language') %>">
    <span class="lang-bar__label"><%= it.t('Language') %>:</span>
<% it.locales.forEach((option) => { %>
    <a href="?lang=<%= option.code %>" lang="<%= option.code %>" hreflang="<%= option.code %>"<%~ option.code === it.locale ? ' aria-current="true"' : '' %>><%= option.name %></a>
<% }) %>
<% if (it.languageNotice) { %>
    <p class="notice" role="status"><%= it.languageNotice %></p>
<% } %>
  </nav>
<% } %>
<% if (it.theme === 'pongal') { %>
<%~ include('./themes/pongal/banner', { eventName: it.eventName, m: it.m }) %>
<% } %>
  <main class="page">
<%~ it.body %>
  </main>
  <script type="module" src="/public/js/navigation.js"></script>
  <script type="module" src="/public/js/form-validation.js"></script>
</body>
</html>
