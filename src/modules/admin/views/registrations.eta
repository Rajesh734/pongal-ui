<% layout('../../survey/views/layout', { title: it.title }) %>
    <section class="card admin-home">
      <p class="admin-banner"><%~ it.t('Signed in as {email}', { email: '<strong>' + it.esc(it.adminEmail) + '</strong>' }) %></p>
      <h1><%= it.t('Registrations') %></h1>
      <form method="get" action="/admin/registrations" class="admin-filters">
        <label for="event"><%= it.t('Event') %></label>
        <select id="event" name="event">
<% it.events.forEach((event) => { %>
          <option value="<%= event.slug %>" <%= it.event?.id === event.id ? 'selected' : '' %>><%= event.name %></option>
<% }) %>
        </select>
        <label for="status"><%= it.t('Payment status') %></label>
        <select id="status" name="status">
          <option value="all" <%= it.status === 'all' ? 'selected' : '' %>><%= it.t('All') %></option>
          <option value="payment_pending" <%= it.status === 'payment_pending' ? 'selected' : '' %>><%= it.t('Payment pending') %></option>
          <option value="confirmed" <%= it.status === 'confirmed' ? 'selected' : '' %>><%= it.t('Confirmed') %></option>
          <option value="cancelled" <%= it.status === 'cancelled' ? 'selected' : '' %>><%= it.t('Cancelled') %></option>
        </select>
        <button class="button" type="submit"><%= it.t('Filter') %></button>
      </form>
<% if (!it.rows.length) { %>
      <p class="muted"><%= it.t('No registrations match these filters.') %></p>
<% } else { %>
      <p><a class="button" href="/admin/registrations.csv?event=<%= it.event.slug %>&amp;status=<%= it.status %>"><%= it.t('Export CSV') %></a></p>
      <p class="table-scroll-hint muted" aria-hidden="true"><%= it.t('Scroll sideways to see all columns') %> &rarr;</p>
      <div class="table-scroll table-scroll--wide" tabindex="0" role="region" aria-label="<%= it.t('Registrations table') %>">
        <table>
          <thead><tr><th><%= it.t('Household') %></th><th><%= it.t('Attendee') %></th><th><%= it.t('Age group') %></th><th><%= it.t('Performances') %></th><th><%= it.t('Amount') %></th><th><%= it.t('Payment') %></th></tr></thead>
<% it.rows.forEach((row) => { const span = Math.max(row.attendees.length, 1); %>
          <tbody class="household-group">
<% (row.attendees.length ? row.attendees : [null]).forEach((attendee, index) => { %>
            <tr>
<% if (index === 0) { %>
              <td rowspan="<%= span %>" class="household-cell">
                <strong><%= row.registration.contactName %></strong>
                <span class="household-cell__email"><%= row.registration.contactEmail %></span>
              </td>
<% } %>
              <td><%= attendee?.name ?? '' %></td>
              <td><%= attendee ? it.ageGroupLabels[attendee.ageBand] ?? attendee.ageBand : '' %></td>
<% if (index === 0) { %>
              <td rowspan="<%= span %>"><%= row.performances.map((performance) => performance.title + ' (' + it.t('{n} min', { n: performance.durationMinutes }) + ')').join('; ') || it.t('None') %></td>
              <td rowspan="<%= span %>">$<%= (row.registration.totalCents / 100).toFixed(2) %></td>
              <td rowspan="<%= span %>"><%= row.payment?.status === 'confirmed' ? it.t('Confirmed') : row.payment?.status === 'pending' || !row.payment ? it.t('Pending') : row.payment.status %></td>
<% } %>
            </tr>
<% }) %>
          </tbody>
<% }) %>
        </table>
      </div>
<% } %>
    </section>