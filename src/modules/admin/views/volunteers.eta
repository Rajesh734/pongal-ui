<% layout('../../survey/views/layout', { title: it.title }) %>
    <section class="card admin-home">
      <p class="admin-banner"><%~ it.t('Signed in as {email}', { email: '<strong>' + it.esc(it.adminEmail) + '</strong>' }) %></p>
      <h1><%= it.t('Volunteers') %></h1>
<% if (it.message) { %>
      <p class="notice" role="<%= it.messageIsError ? 'alert' : 'status' %>"><%= it.message %></p>
<% } %>
      <form method="get" action="/admin/volunteers" class="admin-filters">
        <label for="event"><%= it.t('Event') %></label>
        <select id="event" name="event">
<% it.events.forEach((event) => { %>
          <option value="<%= event.slug %>" <%= it.event?.id === event.id ? 'selected' : '' %>><%= event.name %></option>
<% }) %>
        </select>
        <label for="role"><%= it.t('Volunteer role') %></label>
        <select id="role" name="role">
          <option value="all" <%= it.roleFilter === 'all' ? 'selected' : '' %>><%= it.t('All roles') %></option>
<% it.roleOptions.forEach((role) => { %>
          <option value="<%= role.code %>" <%= it.roleFilter === role.code ? 'selected' : '' %>><%= it.t(role.label) %></option>
<% }) %>
        </select>
        <button class="button" type="submit"><%= it.t('Filter') %></button>
      </form>
<% if (!it.rows.length) { %>
      <p class="muted"><%= it.t('No attendees have volunteered yet.') %></p>
<% } else { %>
      <p class="table-scroll-hint muted" aria-hidden="true"><%= it.t('Scroll sideways to see all columns') %> &rarr;</p>
      <div class="table-scroll table-scroll--wide" tabindex="0" role="region" aria-label="<%= it.t('Volunteers table') %>">
        <table>
          <thead><tr><th><%= it.t('Household') %></th><th><%= it.t('Attendee') %></th><th><%= it.t('Age group') %></th><th><%= it.t('Roles') %></th><th><%= it.t('Check-in access') %></th></tr></thead>
<%
  const groups = [];
  it.rows.forEach((row) => {
    const last = groups.at(-1);
    if (last?.registrationId === row.registrationId) last.rows.push(row);
    else groups.push({ registrationId: row.registrationId, rows: [row] });
  });
%>
<% groups.forEach((group) => { %>
          <tbody class="household-group">
<% group.rows.forEach((row, index) => { %>
            <tr>
<% if (index === 0) { %>
              <td rowspan="<%= group.rows.length %>" class="household-cell">
                <strong><%= row.householdName %></strong>
                <span class="household-cell__email"><%= row.householdEmail %></span>
              </td>
<% } %>
              <td><%= row.attendeeName %></td>
              <td><%= row.ageGroup %></td>
              <td><%= row.roles.join(', ') %></td>
              <td>
<% if (it.grantedEmails.has(row.householdEmail)) { %>
                <span class="muted"><%= it.t('Access granted') %></span>
<% } else { %>
                <form method="post" action="/admin/check-in-access/grant?event=<%= it.event.slug %>&from=volunteers&role=<%= it.roleFilter %>">
                  <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
                  <input type="hidden" name="email" value="<%= row.householdEmail %>">
                  <button class="button" type="submit" aria-label="<%= it.t('Grant check-in access to {name}', { name: row.attendeeName }) %>"><%= it.t('Grant check-in') %></button>
                </form>
<% } %>
              </td>
            </tr>
<% }) %>
          </tbody>
<% }) %>
        </table>
      </div>
<% } %>
    </section>