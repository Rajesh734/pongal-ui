# Local development settings. Copy to .env (git-ignored) and adjust.
# Every value here is a dummy. Any setting can instead be read from a file: set NAME_FILE=/path/to/file.

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Set this to a Web application OAuth client ID authorized for APP_BASE_URL.
GOOGLE_CLIENT_ID=

# Database: pglite (embedded) or postgres
DB_DRIVER=pglite
# Leave empty for an in-memory database (data is lost on restart)
PGLITE_DATA_DIR=./data/pglite
BACKUP_DIR=./data/backups

# Only used when DB_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=community_site
DATABASE_USER=community_site_app
DATABASE_PASSWORD=dummy-db-password

# Secret used to sign survey edit links (dummy value for local use only)
EDIT_TOKEN_KEY=dummy-edit-token-key-change-me

# Cloudflare's public Turnstile test keys (always pass)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Configure all SMTP settings plus SMTP_PASS to enable email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASS=

CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=dummy-access-aud
