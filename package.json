    "drizzle-orm": "^0.45.4",
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@playwright/test": "^1.65.1",
    "drizzle-kit": "^0.31.11",
