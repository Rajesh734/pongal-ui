  "private": true,
  "description": "Community website: Pongal 2027 interest survey and future community apps",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
